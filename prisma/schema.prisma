generator client {
    provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                Int       @id @default(autoincrement())
  firstname         String    @db.VarChar(50)
  lastname          String    @db.VarChar(50)
  birthday          DateTime
  password          String    @db.VarChar(100)
  email             String    @db.VarChar(100) @unique
  onBoarding        Boolean   @default(false)
  imageUrl          String    @db.VarChar(200)
  verificationToken String?
  languageId        Int       @default(1)
  language          Language  @relation(fields: [languageId], references: [id])
  cards             Card[]
  notifications     Notification[]
  EmailVerification EmailVerification?
  categories        Category[]
  signupDate        DateTime @default(now()) // Date d'inscription de l'utilisateur
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  token     String   @unique
  expiresAt DateTime @default(now())
  User      User?    @relation(fields: [userId], references: [id])
  userId    Int?     @unique
}

model Card {
  id            Int       @id @default(autoincrement())
  title         String    @db.VarChar(200)
  answer        String    @db.VarChar(1000)
  level         Int
  lastReviewDate DateTime
  active        Boolean   @default(true)
  userId        Int
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  categoryId    Int?
  category      Category?  @relation(fields: [categoryId], references: [id])
  notifications Notification[]
  createdAt     DateTime  @default(now())
}

model Category {
  id       Int    @id @default(autoincrement())
  name     String @db.VarChar(50)
  colorId  Int
  color    Color  @relation(fields: [colorId], references: [id])
  cards    Card[]
  userId   Int
  user     User   @relation(fields: [userId], references: [id])
}

model Color {
  id       Int       @id @default(autoincrement())
  name     String    @db.VarChar(30)
  fullName String    @db.VarChar(100)
  category Category[]
}

model Notification {
  id        Int   @id @default(autoincrement())
  content   String @db.VarChar(200)
  time      DateTime
  notificationTime DateTime
  userId    Int
  user      User  @relation(fields: [userId], references: [id])
  cardId    Int
  card      Card  @relation(fields: [cardId], references: [id], onDelete: Cascade)
}

model Language {
  id   Int    @id @default(autoincrement())
  code String @db.VarChar(10)
  name String @db.VarChar(20)
  users User[]
}

model Rule {
  id          Int        @id @default(autoincrement())
  ruleName    String     @db.VarChar(50)
  description String     @db.Text
}

model WaitingListEmail {
  id     Int      @id @default(autoincrement())
  email  String   @unique
  verify Boolean  @default(false)
  token  String?
}
